set_io "TX_Debug(0)" iocell 12 3
set_io "ADC_CH0(0)" iocell 2 1
set_io "ADC_CH3(0)" iocell 2 4
set_io "ADC_CH2(0)" iocell 2 3
set_io "ADC_CH1(0)" iocell 2 2
